<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="28dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="局域网远控" android:textSize="28sp" android:textStyle="bold"/>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center" android:text="正在检查网络…" android:textSize="16sp"/>
    <Button android:id="@+id/accessibility" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="1. 开启远控辅助服务"/>
    <Button android:id="@+id/start" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="2. 授权录屏并启动"/>
    <Button android:id="@+id/stop" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="停止服务"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="安全说明：服务只在检测到的 Tailscale 100.x 地址上提供入口；无公共 STUN/TURN；PIN 每次启动随机生成。" android:textSize="13sp"/>
</LinearLayout>
